# Copy to .env.signing (gitignored) on the Mac that runs ./deploy.sh, and fill in.
# deploy.sh sources this file. Never commit the real file or paste its values anywhere.

# Notarization (electron-builder `notarize: true` and the DMG pass in deploy.sh).
# The app-specific password is made at https://account.apple.com (Sign-In and Security).
export APPLE_ID=""
export APPLE_APP_SPECIFIC_PASSWORD=""
export APPLE_TEAM_ID=""

# Code signing. By default electron-builder finds the "Developer ID Application"
# certificate in the login keychain. Set these only to pick a specific identity
# or to sign from an exported .p12 instead.
# export CSC_NAME="Developer ID Application: Your Name (TEAMID)"
# export CSC_LINK="/path/to/developer_id_application.p12"
# export CSC_KEY_PASSWORD=""
